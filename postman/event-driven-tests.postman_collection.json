{
  "info": {
    "name": "Event-Driven Architecture Tests",
    "description": "Collection to test the event-driven microservices architecture with BullMQ, transactional outbox, and idempotency features",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Infrastructure Health Checks",
      "item": [
