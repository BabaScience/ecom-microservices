{
  "info": {
    "name": "User Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{user_base_url}}/health",
          "host": ["{{user_base_url}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "Register User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"password123\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\"\n}"
        },
        "url": {
          "raw": "{{user_base_url}}/api/users/register",
          "host": ["{{user_base_url}}"],
          "path": ["api", "users", "register"]
        }
      }
    },
    {
      "name": "Login User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{user_base_url}}/api/users/login",
          "host": ["{{user_base_url}}"],
          "path": ["api", "users", "login"]
        }
      }
    },
    {
      "name": "Get Profile",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}"
          }
        ],
        "url": {
          "raw": "{{user_base_url}}/api/users/profile",
          "host": ["{{user_base_url}}"],
          "path": ["api", "users", "profile"]
        }
      }
    },
    {
      "name": "Update Profile",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"John Updated\",\n  \"lastName\": \"Doe Updated\",\n  \"address\": {\n    \"street\": \"123 Main St\",\n    \"city\": \"New York\",\n    \"state\": \"NY\",\n    \"zipCode\": \"10001\",\n    \"country\": \"USA\"\n  }\n}"
        },
        "url": {
          "raw": "{{user_base_url}}/api/users/profile",
          "host": ["{{user_base_url}}"],
          "path": ["api", "users", "profile"]
        }
      }
    },
    {
      "name": "Get User by ID (Internal)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{user_base_url}}/api/users/{{user_id}}",
          "host": ["{{user_base_url}}"],
          "path": ["api", "users", "{{user_id}}"]
        }
      }
    },
    {
      "name": "Create Admin User (Dev Only)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"admin123\",\n  \"firstName\": \"Admin\",\n  \"lastName\": \"User\"\n}"
        },
        "url": {
          "raw": "{{user_base_url}}/api/users/create-admin",
          "host": ["{{user_base_url}}"],
          "path": ["api", "users", "create-admin"]
        }
      }
    },
    {
      "name": "Update User Role (Admin Only)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"role\": \"admin\"\n}"
        },
        "url": {
          "raw": "{{user_base_url}}/api/users/{{user_id}}/role",
          "host": ["{{user_base_url}}"],
          "path": ["api", "users", "{{user_id}}", "role"]
        }
      }
    }
  ]
}

