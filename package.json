{
  "name": "ecom-microservices",
  "private": true,
  "packageManager": "bun@1.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "audit": "bun audit",
    "ci:install": "bun install --frozen-lockfile",
    "ci:build": "bun run build",
    "ci:test": "bun run test",
    "ci:lint": "bun run lint",
    "ci:type-check": "bun run type-check"
  },
  "devDependencies": {
    "turbo": "^2.1.1",
    "typescript": "^5.4.0"
  }
}

