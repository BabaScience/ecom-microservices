# Root Environment Variables for All Services
NODE_ENV=development

# JWT Configuration (shared across services)
JWT_SECRET=your-development-secret-key-change-in-production
JWT_EXPIRATION=24h

# Service Ports
GATEWAY_PORT=3000
USER_SERVICE_PORT=3001
PRODUCT_SERVICE_PORT=3002
ORDER_SERVICE_PORT=3003

# Service URLs (for inter-service communication)
USER_SERVICE_URL=http://localhost:3001
PRODUCT_SERVICE_URL=http://localhost:3002
ORDER_SERVICE_URL=http://localhost:3003

# MongoDB Configuration (each service has its own database)
MONGODB_URI=mongodb://admin:password@localhost:27017/ecommerce?authSource=admin

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# CORS Configuration
CORS_ORIGIN=*
